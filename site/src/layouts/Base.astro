---
import '@fontsource-variable/public-sans';
import '@fontsource-variable/public-sans/wght-italic.css';
import '@fontsource-variable/source-serif-4';
import '../styles/global.css';
import { manifest } from '../lib/data';
import { INDEXABLE, SITE_URL, REPO_URL } from '../lib/site';

interface Props { title: string; description: string; current?: string }
const { title, description, current } = Astro.props;
const nav = [
  { href: '/', label: 'Overview', key: 'overview' },
  { href: '/institutions/', label: 'Institutions', key: 'institutions' },
  { href: '/compare/', label: 'Compare', key: 'compare' },
  { href: '/methods/', label: 'Methods', key: 'methods' },
  { href: '/downloads/', label: 'Downloads', key: 'downloads' },
  { href: '/about/', label: 'About', key: 'about' },
];
const canonical = new URL(Astro.url.pathname, SITE_URL).href;
const pageTitle = title === 'Overview' ? 'Connecticut Open Access Observatory' : `${title} · Connecticut Open Access Observatory`;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    {!INDEXABLE && <meta name="robots" content="noindex" />}
    <link rel="canonical" href={canonical} />
    <meta name="referrer" content="no-referrer" />
    <meta name="color-scheme" content="light dark" />
    <link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'%3E%3Crect width='32' height='32' rx='6' fill='%239b1c31'/%3E%3Cpath d='M9 22V10h3l4 7 4-7h3v12' fill='none' stroke='white' stroke-width='2.5'/%3E%3C/svg%3E" />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to main content</a>
    <header class="site-header">
      <div class="col-wide">
        <a class="brand" href="/">Connecticut Open Access Observatory</a>
        <nav class="site-nav" aria-label="Main">
          <ul>
            {nav.map((item) => (
              <li><a href={item.href} aria-current={current === item.key ? 'page' : undefined}>{item.label}</a></li>
            ))}
          </ul>
        </nav>
      </div>
    </header>
    <main id="main" tabindex="-1">
      <div class="col">
        <slot />
      </div>
    </main>
    <footer class="site-footer">
      <div class="col">
        <p>
          Figures use data downloaded from <a href="https://openalex.org/">OpenAlex</a> on
          {' '}<time datetime={manifest.snapshot_date}>{new Date(manifest.snapshot_date + 'T12:00:00Z').toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric', timeZone: 'UTC' })}</time>.
          OpenAlex is in the public domain (CC0), and so is this site’s data.
        </p>
        <p>Scope: {manifest.scope}</p>
        <p>No cookies, no analytics, and nothing loaded from other servers.</p>
        <p>
          <a href="/methods/">How the numbers are made</a>{' · '}
          <a href="/downloads/">Download the data</a>{' · '}
          <a href="/changelog/">Changelog</a>{' · '}
          <a href={REPO_URL}>Code and pipeline on GitHub</a>
        </p>
      </div>
    </footer>
  </body>
</html>
