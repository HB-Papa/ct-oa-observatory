---
// Two-series line chart of a share over the complete years (2015-2025), with
// the incomplete year (2026) drawn as a separate hollow point in a shaded band
// and not joined to the line. One y-axis. 2px lines, 8px+ markers with a 2px
// surface ring, direct end labels plus a legend.
import { pct0 } from '../lib/format';

interface Pt { year: number; share: number; incomplete: boolean }
interface Props { a: { name: string; points: Pt[] }; b?: { name: string; points: Pt[] }; yMin?: number; yMax?: number }
const { a, b, yMin = 0.4, yMax = 0.8 } = Astro.props;

const W = 640, H = 300, L = 44, R = 150, T = 16, B = 34;
const years = a.points.map((p) => p.year);
const x0 = Math.min(...years), x1 = Math.max(...years);
const x = (yr: number) => L + ((yr - x0) / (x1 - x0)) * (W - L - R);
const y = (v: number) => T + (1 - (v - yMin) / (yMax - yMin)) * (H - T - B);
const ticks: number[] = [];
for (let v = yMin; v <= yMax + 1e-9; v += 0.1) ticks.push(Math.round(v * 10) / 10);
const path = (pts: Pt[]) => pts.filter((p) => !p.incomplete).map((p, i) => `${i ? 'L' : 'M'}${x(p.year).toFixed(1)},${y(p.share).toFixed(1)}`).join(' ');
const last = (pts: Pt[]) => pts.filter((p) => !p.incomplete).at(-1)!;
const inc = (pts: Pt[]) => pts.find((p) => p.incomplete);
const series = [{ s: a, cls: 'a' }, ...(b ? [{ s: b, cls: 'b' }] : [])];
// End labels: nudge apart only if they would overlap.
const ends = series.map(({ s, cls }) => ({ cls, name: s.name, v: last(s.points).share, yy: y(last(s.points).share) }));
if (ends.length === 2 && Math.abs(ends[0].yy - ends[1].yy) < 32) {
  const [hi, lo] = ends[0].yy < ends[1].yy ? [ends[0], ends[1]] : [ends[1], ends[0]];
  const mid = (hi.yy + lo.yy) / 2; hi.yy = mid - 16; lo.yy = mid + 16;
}
const incX = x(x1);
---
<ul class="legend" aria-hidden="true">
  {series.map(({ s, cls }) => (<li><span class="line-key" style={`background: var(--s-${cls})`}></span>{s.name}</li>))}
  <li><svg width="14" height="14" aria-hidden="true"><circle cx="7" cy="7" r="5" fill="none" stroke="currentColor" stroke-width="2" /></svg>2026, incomplete year</li>
</ul>
<div class="chart-scroll">
  <svg viewBox={`0 0 ${W} ${H}`} role="presentation" aria-hidden="true" focusable="false">
    <rect class="incomplete-band" x={incX - 14} y={T} width="28" height={H - T - B} rx="4" />
    {ticks.map((t) => (
      <g>
        <line class="grid" x1={L} x2={W - R + 18} y1={y(t)} y2={y(t)} />
        <text x={L - 8} y={y(t) + 4} text-anchor="end">{pct0(t)}</text>
      </g>
    ))}
    <line class="axis" x1={L} x2={W - R + 18} y1={H - B} y2={H - B} />
    {years.map((yr) => (yr % 2 === 1 || yr === x1) && (
      <text x={x(yr)} y={H - B + 20} text-anchor="middle">{yr}</text>
    ))}
    {series.map(({ s, cls }) => (
      <g>
        <path d={path(s.points)} fill="none" class={`s-${cls}`} stroke-width="2" stroke-linejoin="round" stroke-linecap="round" />
        <circle cx={x(last(s.points).year)} cy={y(last(s.points).share)} r="4.5" class={`dot-${cls}`} />
        {inc(s.points) && <circle cx={x(inc(s.points)!.year)} cy={y(inc(s.points)!.share)} r="4.5" class={`hollow-${cls}`} />}
      </g>
    ))}
    {ends.map((e) => (
      <text class="end-label" x={x(x1) + 20} y={e.yy + 4}>{pct0(e.v)} <tspan font-weight="400">{e.name}</tspan></text>
    ))}
  </svg>
</div>
