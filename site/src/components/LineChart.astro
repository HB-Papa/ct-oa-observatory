---
// Two-series line chart of a share by year. Complete years (2015-2025) are a
// solid line; the incomplete year (2026) is a hollow point in a shaded band,
// joined to 2025 by a dashed segment. One y-axis. 2px lines, markers with a
// 2px surface ring, short-name end labels plus a legend with full names.
//
// Hover readout, with no JavaScript: each year has an invisible full-height
// column. Hovering it shows a guide line, larger dots and a small box with the
// year's figures. The box sits in a strip reserved above the plot, so it never
// covers other content (which keeps it within WCAG 1.4.13 without a dismiss
// key). The chart is hidden from screen readers; the summary and table carry
// every number, and keyboard users get them from the table.
import { pct, pct0, n } from '../lib/format';

interface Pt { year: number; share: number; incomplete: boolean; works?: number; free?: number }
interface Series { name: string; short?: string; points: Pt[] }
interface Props { a: Series; b?: Series; yMin?: number; yMax?: number }
const { a, b, yMin = 0.4, yMax = 0.8 } = Astro.props;

// Text widths are estimated generously (13px Public Sans averages under 7.5
// chart units per character; 8.2 leaves room for bold digits and font fallback),
// so the right margin and the hover box always fit their longest text.
const CHAR = 8.2;
const endTexts = [a, ...(b ? [b] : [])].map((s) => `100% ${s.short ?? s.name}`);
const W = 680, H = 440, L = 46, TIP = 62, T = TIP + 14, B = 36;
const R = Math.ceil(34 + Math.max(...endTexts.map((t) => t.length)) * CHAR);
const years = a.points.map((p) => p.year);
const x0 = Math.min(...years), x1 = Math.max(...years);
const step = (W - L - R) / (x1 - x0);
const x = (yr: number) => L + (yr - x0) * step;
const y = (v: number) => T + (1 - (v - yMin) / (yMax - yMin)) * (H - T - B);
const ticks: number[] = [];
for (let v = yMin; v <= yMax + 1e-9; v += 0.1) ticks.push(Math.round(v * 10) / 10);
const path = (pts: Pt[]) => pts.filter((p) => !p.incomplete).map((p, i) => `${i ? 'L' : 'M'}${x(p.year).toFixed(1)},${y(p.share).toFixed(1)}`).join(' ');
const last = (pts: Pt[]) => pts.filter((p) => !p.incomplete).at(-1)!;
const inc = (pts: Pt[]) => pts.find((p) => p.incomplete);
const series = [{ s: a, cls: 'a' }, ...(b ? [{ s: b, cls: 'b' }] : [])];
const label = (s: Series) => s.short ?? s.name;
// End labels: nudge apart only if they would overlap.
const ends = series.map(({ s, cls }) => ({ cls, name: label(s), v: last(s.points).share, yy: y(last(s.points).share) }));
if (ends.length === 2 && Math.abs(ends[0].yy - ends[1].yy) < 32) {
  const [hi, lo] = ends[0].yy < ends[1].yy ? [ends[0], ends[1]] : [ends[1], ends[0]];
  const mid = (hi.yy + lo.yy) / 2; hi.yy = mid - 16; lo.yy = mid + 16;
}
const incX = x(x1);
const lastX = x(last(a.points).year);
// Hover readout box
const line = (p: Pt | undefined) => (p ? `${pct(p.share)}${p.free != null && p.works != null ? ` · ${n(p.free)} of ${n(p.works)} free` : ''}` : '');
const longest = Math.max(...years.flatMap((yr) => series.map(({ s }) => `${label(s)} ${line(s.points.find((q) => q.year === yr))}`.length)), 24);
const TW = Math.min(Math.ceil(longest * 7.6 + 36), W - 4), TH = 22 + series.length * 19;
const tipX = (yr: number) => Math.min(Math.max(x(yr) - TW / 2, 2), W - TW - 2);
---
<ul class="legend" aria-hidden="true">
  {series.map(({ s, cls }) => (<li><span class="line-key" style={`background: var(--s-${cls})`}></span>{s.name}</li>))}
  <li><svg width="22" height="14" aria-hidden="true"><line x1="1" x2="21" y1="7" y2="7" stroke="currentColor" stroke-width="2" stroke-dasharray="4 3" /></svg>{x1}, incomplete year</li>
</ul>
<p class="small muted chart-hint" aria-hidden="true">Point at a year to see its figures.</p>
<div class="chart-scroll" tabindex="0" role="region" aria-label="Line chart, scrolls sideways on narrow screens. The same numbers are in the table below.">
  <svg class="line-chart" viewBox={`0 0 ${W} ${H}`} role="presentation" aria-hidden="true" focusable="false">
    <rect class="incomplete-band" x={incX - 16} y={T} width="32" height={H - T - B} rx="4" />
    {ticks.map((t) => (
      <g>
        <line class="grid" x1={L} x2={W - R + 20} y1={y(t)} y2={y(t)} />
        <text x={L - 8} y={y(t) + 4} text-anchor="end">{pct0(t)}</text>
      </g>
    ))}
    <line class="axis" x1={L} x2={W - R + 20} y1={H - B} y2={H - B} />
    {years.map((yr) => (yr % 2 === 1 || yr === x1) && (
      <text x={x(yr)} y={H - B + 22} text-anchor="middle">{yr}</text>
    ))}
    {series.map(({ s, cls }) => (
      <g>
        <path d={path(s.points)} fill="none" class={`s-${cls}`} stroke-width="2" stroke-linejoin="round" stroke-linecap="round" />
        {inc(s.points) && (
          <line class={`s-${cls}`} x1={lastX} y1={y(last(s.points).share)} x2={x(inc(s.points)!.year)} y2={y(inc(s.points)!.share)}
                stroke-width="2" stroke-dasharray="5 4" stroke-linecap="round" />
        )}
        <circle cx={x(last(s.points).year)} cy={y(last(s.points).share)} r="4.5" class={`dot-${cls}`} />
        {inc(s.points) && <circle cx={x(inc(s.points)!.year)} cy={y(inc(s.points)!.share)} r="4.5" class={`hollow-${cls}`} />}
      </g>
    ))}
    {ends.map((e) => (
      <text class="end-label" x={x(x1) + 22} y={e.yy + 4}>{pct0(e.v)} <tspan font-weight="400">{e.name}</tspan></text>
    ))}
    {years.map((yr) => {
      const pts = series.map(({ s, cls }) => ({ s, cls, p: s.points.find((q) => q.year === yr) }));
      const isInc = pts[0].p?.incomplete;
      return (
        <g class="yr">
          <rect class="yr-hit" x={x(yr) - step / 2} y="0" width={step} height={H - B} />
          <g class="yr-show">
            <line class="yr-guide" x1={x(yr)} x2={x(yr)} y1={T} y2={H - B} />
            {pts.map(({ cls, p }) => p && <circle cx={x(yr)} cy={y(p.share)} r="6.5" class={isInc ? `hollow-${cls}` : `dot-${cls}`} />)}
            <g transform={`translate(${tipX(yr).toFixed(1)},4)`}>
              <rect class="yr-tip" width={TW} height={TH} rx="4" />
              <text class="yr-tip-year" x="10" y="17">{yr}{isInc ? ' (incomplete year)' : ''}</text>
              {pts.map(({ s, cls, p }, i) => (
                <g transform={`translate(10,${34 + i * 19})`}>
                  <rect y="-9" width="10" height="10" rx="2" class={`key-${cls}`} />
                  <text class="yr-tip-text" x="16" y="0"><tspan font-weight="700">{label(s)}</tspan> {line(p)}</text>
                </g>
              ))}
            </g>
          </g>
        </g>
      );
    })}
  </svg>
</div>
